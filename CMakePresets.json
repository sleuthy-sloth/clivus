{
  "version": 6,
  "configurePresets": [
    {
      "name": "mac",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mac",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/qt",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      }
    },
    {
      "name": "mac-core",
      "inherits": "mac",
      "binaryDir": "${sourceDir}/build/mac-core",
      "cacheVariables": {
        "CLIVUS_BUILD_APP": "OFF"
      }
    },
    {
      "name": "win",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/win",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "mac-vtk",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mac-vtk",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/qt",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "CLIVUS_BUILD_VTK_PROBE": "ON"
      },
      "displayName": "macOS + VTK probe"
    },
    {
      "name": "linux",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "displayName": "Linux (distro Qt6 + DCMTK)"
    },
    {
      "name": "linux-core",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/linux-core",
      "cacheVariables": {
        "CLIVUS_BUILD_APP": "OFF"
      },
      "displayName": "Linux, core only (no Qt GUI)"
    }
  ],
  "buildPresets": [
    {
      "name": "mac",
      "configurePreset": "mac"
    },
    {
      "name": "mac-core",
      "configurePreset": "mac-core"
    },
    {
      "name": "win",
      "configurePreset": "win",
      "configuration": "Release"
    },
    {
      "name": "mac-vtk",
      "configurePreset": "mac-vtk",
      "displayName": "macOS + VTK probe"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "linux-core",
      "configurePreset": "linux-core"
    }
  ],
  "testPresets": [
    {
      "name": "mac-core",
      "configurePreset": "mac-core",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "win",
      "configurePreset": "win",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-core",
      "configurePreset": "linux-core",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
